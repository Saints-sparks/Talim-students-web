# Copy to .env.local. NEXT_PUBLIC_API_BASE_URL is required — the build fails without it.
NEXT_PUBLIC_API_BASE_URL=https://talim-be-dev.onrender.com
# Optional; defaults to the API origin.
NEXT_PUBLIC_WEBSOCKET_URL=
# Profile photo uploads go straight to Cloudinary (an unsigned upload preset).
# Both are required for the profile and onboarding photo upload to work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
